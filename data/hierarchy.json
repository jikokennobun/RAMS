{
  "profile": "working-bicrl-v1",
  "description": "S005 v11 §1.1–1.2との定義照合済み。同じ署名・量化規約を保持。sourceの証明状態と独立監査状態は別管理。",
  "principles": [
    {
      "id": "N",
      "definition": "box(1)=1",
      "kind": "axiom"
    },
    {
      "id": "K",
      "definition": "box(a -> b) <= (box(a) -> box(b))",
      "kind": "axiom"
    },
    {
      "id": "4",
      "definition": "box(a) <= box(box(a))",
      "kind": "axiom"
    },
    {
      "id": "gFPP",
      "definition": "全元パラメータを許す各ガード付き一変数項に解が存在する",
      "kind": "fixed_point"
    },
    {
      "id": "gU",
      "definition": "全元パラメータを許す各ガード付き一変数項の解は高々一つ",
      "kind": "fixed_point"
    },
    {
      "id": "gUFPP",
      "definition": "全元パラメータを許す各ガード付き一変数項の解はちょうど一つ",
      "kind": "fixed_point"
    },
    {
      "id": "gTFPP",
      "definition": "単一代数Aでforall guarded t(p,a) exists p-free original-language term s_t(a) forall a: s_t(a)=t(s_t(a),a)。任意元の新規定数を選択項へ追加しない。",
      "kind": "fixed_point",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "gUTFPP",
      "definition": "gTFPP and gU",
      "kind": "fixed_point",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "Lob",
      "definition": "forall a: box(a)<=a implies a=1",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "FLob",
      "definition": "forall a: box(box(a)->a)<=box(a)",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "sLob",
      "definition": "forall a: (box(a)->a)<=a",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "SC",
      "definition": "forall a exists p: p=(box(p)->a)",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "Mix",
      "definition": "forall x: box(x)<=box(x) product box(box(x))",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "IA_box",
      "definition": "forall x: box(x product box(x))=box(x)",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "MC",
      "definition": "A上に完備分離的距離dと一様0<=q<1が存在しboxがq縮小",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "uMC",
      "definition": "MCの超距離版",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "AMC",
      "definition": "MCかつ全ての非様相基本演算がmax積距離について非拡大",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "uAMC",
      "definition": "AMCの超距離版",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "CongruenceTower",
      "definition": "A^-上に分離的合同降鎖theta_0=nablaとbox-shiftと全単射A->lim A^-/theta_nを満たすある塔が存在。正準Phi塔とは区別。",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "UniformApproximation",
      "definition": "有限ガード系の解操作が元言語の反復項のパラメータ一様極限となる",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "M",
      "definition": "boxは単調",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "C",
      "definition": "box(x) product box(y)<=box(x product y)",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "Abs",
      "definition": "x<=x product box(x)",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "CP",
      "definition": "x<=box(x)",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "Ctr",
      "definition": "x<=x product x",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "Ctr_box",
      "definition": "box(x)<=box(x) product box(x)",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "bAMC",
