      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "PhiComp",
      "definition": "正準Phi塔の全整合剰余類列がAで実現される",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "ImgSep",
      "definition": "intersection_n box^n[A]={1}",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "TermUniformClosed",
      "definition": "各有限パラメータarityの項関数集合が上限距離の下一様閉",
      "kind": "source_defined",
      "source_ids": [
        "S005"
      ]
    },
    {
      "id": "UF_all",
      "definition": "全濃度kappaで有限支持fully guarded連立系が唯一解を持つ",
      "kind": "source_defined",
      "source_ids": [
