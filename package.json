{
  "name": "rams-research",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "models": "node scripts/check-models.mjs",
    "plan": "node scripts/prepare-task.mjs",
    "hierarchy": "node scripts/hierarchy.mjs",
    "experiments": "node scripts/experiments.mjs",
    "certificate": "node scripts/experiments.mjs verify",
    "import:v11": "node scripts/import-v11.mjs",
    "import:check": "node scripts/import-v11.mjs --check",
    "witness:v11": "node scripts/verify-v11-witness.mjs --check",
    "catalog": "node scripts/catalog.mjs",
    "research:status": "node scripts/research-system.mjs status",
    "research:plan": "node scripts/research-system.mjs plan",
    "research:run": "node scripts/research-system.mjs run",
    "research:cycle": "node scripts/research-system.mjs cycle",
    "verify": "npm run check && npm run import:check && node scripts/research-system.mjs check && npm test && npm run models && npm run witness:v11"
  }
}
